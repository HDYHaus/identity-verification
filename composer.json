{
  "name": "hdyhaus/identity-verification",
  "description": "Verified WordPress registration with pluggable identity verification providers, starting with Prembly.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test": [
      "@test:provider",
      "@test:settings",
      "@test:registration",
      "@test:privacy",
      "@test:user-profile"
    ],
    "test:provider": "php tests/test-prembly-provider.php",
    "test:settings": "php tests/test-settings-page.php",
    "test:registration": "php tests/test-registration-controller.php",
    "test:privacy": "php tests/test-privacy.php",
    "test:user-profile": "php tests/test-user-verification-profile.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
